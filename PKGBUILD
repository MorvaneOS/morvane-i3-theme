# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for i3. Everything installed is generated by tools/build.py and
# committed, so building the package needs nothing but the repo.

pkgname=morvane-i3-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for i3: window and bar colours and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-i3-theme'
# The config is i3's own default with the MorvaneOS look added
license=(BSD-3-Clause)
depends=(
  i3-wm               # include in configs needs 4.20 or later
  morvane-gtk-theme   # GTK apps, icons, cursor
  morvane-wm-theme    # xterm and friends
  morvane-wallpapers
  xwallpaper
)

package() {
  install -Dm644 "$startdir"/config/config -t "$pkgdir/usr/share/morvane-i3-theme/"
  # New users' ~/.config/i3/config includes the file above (see README)
  install -Dm644 "$startdir"/skel/config -t "$pkgdir/etc/skel/.config/i3/"
}
